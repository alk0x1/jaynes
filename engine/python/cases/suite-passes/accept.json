   "Makefile": "test:\n\t-rm gone.txt\n\tgrep -q hi greeting.txt\n"
  },
  "project": {
   "Makefile": "test:\n\t-rm gone.txt\n\tgrep -q hi greeting.txt\n",
   "greeting.txt": "hi\n"
  }
 },
