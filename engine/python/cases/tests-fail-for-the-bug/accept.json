 {
  "id": "sh-assertion-with-saw",
  "expect": "accept",
  "keeps": "a test that fails on what it asserts and shows what it got, word for word",
  "with": {
   "suite_step": "runner",
   "write": [
    "tests/**"
   ],
   "saw": true
  },
  "given": [
   {
    "step": "runner",
    "output": {
     "kind": "script",
     "suite": "sh tests/run.sh",
     "each": "sh",
     "found": "tests/run.sh"
    }
   }
  ],
  "output": {
   "reproduced": true,
   "tests": [
    "tests/done.sh"
   ],
   "failure": "expected Done, got Not done",
   "saw": "Not done"
  },
  "project": {
   "tests/run.sh": "sh tests/done.sh\n",
   "tests/done.sh": "grep -q '>Done<' page.html || { echo 'expected Done, got Not done'; exit 1; }\n",
   "page.html": "<style>[data-row=\"todo\"]{color:red}</style>\n<div data-row=\"todo\">Buy milk</div>\n<span class=\"state\">Not done</span>\n"
  }
 },
 {
  "id": "python-assertion-error",
  "expect": "accept",
  "keeps": "an AssertionError is the test asserting, never its own code breaking",
  "with": {
   "suite_step": "runner",
   "write": [
    "tests/**"
   ],
   "saw": true
  },
  "given": [
   {
    "step": "runner",
    "output": {
     "kind": "script",
     "suite": "python3 tests/test_done.py",
     "each": "python3",
     "found": "tests/test_done.py"
    }
   }
  ],
  "output": {
   "reproduced": true,
   "tests": [
    "tests/test_done.py"
   ],
   "failure": "AssertionError: got Not done",
   "saw": "got Not done"
  },
  "project": {
   "tests/test_done.py": "state = 'Not done'\nassert state == 'Done', f'got {state}'\n"
  }
 },
 {
  "id": "python-unittest-failure",
  "expect": "accept",
  "keeps": "unittest's own failure of an assertEqual",
  "with": {
   "suite_step": "runner",
   "write": [
    "tests/**"
   ],
   "saw": true
  },
  "given": [
   {
    "step": "runner",
    "output": {
     "kind": "script",
     "suite": "python3 tests/test_done.py",
     "each": "python3",
     "found": "tests/test_done.py"
    }
   }
  ],
  "output": {
   "reproduced": true,
   "tests": [
    "tests/test_done.py"
   ],
   "failure": "AssertionError: 'Not done' != 'Done'",
   "saw": "'Not done' != 'Done'"
  },
  "project": {
   "tests/test_done.py": "import unittest\nclass Done(unittest.TestCase):\n    def test_done(self):\n        self.assertEqual('Not done', 'Done')\nunittest.main()\n"
  }
 },
 {
  "id": "the-app-s-own-exception",
  "expect": "accept",
  "keeps": "the exception comes from the program under test, not from the test: that is the bug",
  "with": {
   "suite_step": "runner",
   "write": [
    "tests/**"
   ]
  },
  "given": [
   {
    "step": "runner",
    "output": {
     "kind": "script",
     "suite": "python3 tests/test_total.py",
     "each": "python3",
     "found": "tests/test_total.py"
    }
   }
  ],
  "output": {
   "reproduced": true,
   "tests": [
    "tests/test_total.py"
   ],
   "failure": "ValueError: coupon expired"
  },
  "project": {
   "tests/test_total.py": "import sys\nsys.path.insert(0, '.')\nimport app\nprint(app.total())\n",
   "app.py": "def total():\n    raise ValueError('coupon expired')\n"
  }
 },
