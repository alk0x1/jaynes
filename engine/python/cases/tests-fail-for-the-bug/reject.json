[
 {
  "id": "passes-before-the-fix",
  "hole": "a test that passes before any fix shows no bug",
  "with": {
   "suite_step": "runner",
   "write": [
    "tests/**"
   ]
  },
  "given": [
   {
    "step": "runner",
    "output": {
     "kind": "script",
     "suite": "sh tests/run.sh",
     "each": "sh",
     "found": "tests/run.sh"
    }
   }
  ],
  "output": {
   "reproduced": true,
   "tests": [
    "tests/says_hi.sh"
   ],
   "failure": "expected hi, got hello"
  },
  "project": {
   "tests/run.sh": "sh tests/says_hi.sh\n",
   "tests/says_hi.sh": "echo 'expected hi, got hello'; grep -q hi greeting.txt\n",
   "greeting.txt": "hi\n"
  },
  "expect": "reject"
 },
