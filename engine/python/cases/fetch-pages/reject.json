   }
  },
  "expect": "reject"
 },
 {
  "id": "never-ends",
  "hole": "a page that never ends, a few bytes at a time: refused when its clock runs out, as Jaynes could not read it in time, since a server that holds on on purpose and one that is slow look the same; fetch-pages counts it as not read when another page or one that always answers did",
  "url": "https://docs.example.org/a",
  "resolve": {
   "docs.example.org": [
    "93.184.215.14"
   ]
  },
  "answers": {
   "https://docs.example.org/a": {
    "status": 200,
    "headers": {
     "content-type": "text/html"
    },
    "body": "<p>FILL</p>",
    "endless": true
   }
  },
  "expect": "reject"
 },
