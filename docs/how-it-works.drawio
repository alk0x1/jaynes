<mxfile host="app.diagrams.net"><diagram id="page-1" name="How it works"><mxGraphModel dx="1700" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1720" pageHeight="1000" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="How Jaynes works" style="text;html=1;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1d2433;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="900" height="36" as="geometry" /></mxCell><mxCell id="subtitle" value="Fixed steps and checks keep the agent from skipping steps or delivering junk; your answers at the stops measure where it can be trusted, so you stop reviewing exactly there." style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#4a5468;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1300" height="30" as="geometry" /></mxCell><mxCell id="s1" value="1. You define the work" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#c3c9d4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2b3445;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="330" height="560" as="geometry" /></mxCell><UserObject id="role" label="Role (a kind of work)&#10;Python code: the steps in order, the shape of each step's output, the checks, and where you stop it.&#10;E.g. redesign: references → current → direction → apply → accept" link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#4-role-definition" tooltip="jaynes.role. A step can only use steps defined before it, so the order is already safe. Changing the text, the schema, a check or the budget opens a new window of labels." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;"><mxGeometry x="60" y="140" width="290" height="170" as="geometry" /></mxCell></UserObject><mxCell id="task" value="Task&#10;A concrete request for the role.&#10;E.g. &quot;Redesign it like https://linear.app&quot;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="290" height="80" as="geometry" /></mxCell><mxCell id="start" value="New run, in the page or with jaynes run --role ... --task ...&#10;Starts a run (one execution of the role for one task). After a crash, the run resumes from the log." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="290" height="100" as="geometry" /></mxCell><mxCell id="s2" value="2. The conductor runs one step at a time" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#c3c9d4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2b3445;" vertex="1" parent="1"><mxGeometry x="400" y="100" width="920" height="560" as="geometry" /></mxCell><UserObject id="ws" label="1 · Prepares a fresh folder&#10;Puts in the checked outputs (and files) of earlier steps, read-only, and records the hash of every file (the manifest)." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#5-step-execution-protocol" tooltip="runs/&lt;run&gt;/&lt;step&gt;/turn-&lt;k&gt;/workspace, with inputs/&lt;step&gt;.json and step.json. A scratch folder next to it is the agent's TMPDIR." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f1fd;strokeColor=#3b7dd8;fontColor=#1d2433;"><mxGeometry x="420" y="140" width="200" height="120" as="geometry" /></mxCell></UserObject><UserObject id="turn" label="2 · One agent turn&#10;The agent reads the inputs and writes output.json. Tokens and model come from the runtime's meter, not from what the agent says." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#5-step-execution-protocol" tooltip="jaynes.runtimes. A deadline per turn (900 s by default); the whole process group is killed at the deadline. An exhausted quota pauses the run without spending an attempt." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;"><mxGeometry x="650" y="140" width="200" height="120" as="geometry" /></mxCell></UserObject><UserObject id="boundary" label="3 · Write boundary&#10;Compares the folder with the manifest: any file created, changed or deleted besides output.json rejects the turn." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#5-step-execution-protocol" tooltip="The second wall. The first is the runtime's sandbox, which already blocks writes outside the folder and the network." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f1fd;strokeColor=#3b7dd8;fontColor=#1d2433;"><mxGeometry x="880" y="140" width="200" height="120" as="geometry" /></mxCell></UserObject><UserObject id="check" label="4 · Shape and checks&#10;Validates output.json against the schema (Pydantic) and runs the step's checks, which may look at earlier outputs." link="https://pydantic.dev/docs/validation/latest/concepts/models/" tooltip="A check returns Pass() or Fail(reasons). A check that raises or returns anything else counts as a failure." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f1fd;strokeColor=#3b7dd8;fontColor=#1d2433;"><mxGeometry x="1100" y="140" width="200" height="120" as="geometry" /></mxCell></UserObject><UserObject id="claude" label="Claude Code&#10;claude -p, OS sandbox, writes only in the folder; web only on steps that allow it" link="https://code.claude.com/docs/en/overview" tooltip="Uses your subscription login. Hooks, MCP, memory and plugins are off during the turn. On a web step, WebFetch and WebSearch are allowed and every address read is recorded." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;"><mxGeometry x="650" y="300" width="95" height="124" as="geometry" /></mxCell></UserObject><UserObject id="codex" label="Codex&#10;codex exec, workspace-write sandbox, no network; search only on web steps" link="https://learn.chatgpt.com/docs/codex/cli" tooltip="User config and rules ignored; ephemeral session. Since it does not report the model, the CLI version goes into the fingerprint." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;"><mxGeometry x="755" y="300" width="95" height="124" as="geometry" /></mxCell></UserObject><UserObject id="trusted" label="Trusted executor&#10;Jaynes itself produces the output when the agent could fake the evidence (references, previews, tests)." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#4-role-definition" tooltip="run_by=fn. The function's code goes into the fingerprint. It skips steps 2 and 3, and may leave files for the steps that need it." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;"><mxGeometry x="1100" y="440" width="200" height="110" as="geometry" /></mxCell></UserObject><UserObject id="rejected" label="Rejected&#10;The reason goes back into the prompt and the agent tries again, up to 3 times. You see none of this." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#5-step-execution-protocol" tooltip="TurnRejected with a reason: write_boundary, schema, check, deadline, runtime or executor. A turn interrupted by a crash or the quota does not count." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#fdecec;strokeColor=#d64545;fontColor=#1d2433;"><mxGeometry x="880" y="300" width="200" height="110" as="geometry" /></mxCell></UserObject><UserObject id="blocked" label="Blocked run&#10;After 3 rejections in a row on the same step, the run stops and enters your queue." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#5-step-execution-protocol" tooltip="RunBlocked with the last reasons. It stays blocked until someone acts." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#fdecec;strokeColor=#d64545;fontColor=#1d2433;"><mxGeometry x="880" y="440" width="200" height="90" as="geometry" /></mxCell></UserObject><UserObject id="witness" label="5 · Checked output (witness)&#10;Only now does the output exist for later steps: stored by its hash, with the hash of the check." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#2-concepts" tooltip="Checked[T]. Only the conductor creates it. objects/&lt;sha256&gt;.json." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f7ef;strokeColor=#2f9e66;fontColor=#1d2433;"><mxGeometry x="1100" y="300" width="200" height="90" as="geometry" /></mxCell></UserObject><UserObject id="decide" label="6 · Is there a stop?&#10;No stop, or certified and skipped by the coin: go on. Otherwise, wait for you." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#61-at-a-stop" tooltip="Floor: always waits. Certified: waits only if the coin lands in the audit slice (10%). Undetermined or refuted: always waits. The coin is a hash of the run and the step, so a replay decides the same way." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff3e0;strokeColor=#d9822b;fontColor=#1d2433;"><mxGeometry x="630" y="440" width="220" height="110" as="geometry" /></mxCell></UserObject><mxCell id="next" value="7 · Next step&#10;until the last; then the run ends (RunFinished)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f7ef;strokeColor=#2f9e66;fontColor=#1d2433;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="200" height="70" as="geometry" /></mxCell><mxCell id="s3" value="3. You answer only where it matters" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#c3c9d4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2b3445;" vertex="1" parent="1"><mxGeometry x="1350" y="100" width="330" height="560" as="geometry" /></mxCell><mxCell id="you" value="You" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#fff3e0;strokeColor=#d9822b;fontColor=#1d2433;align=center;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1370" y="140" width="290" height="50" as="geometry" /></mxCell><UserObject id="page" label="Review page&#10;jaynes, only on 127.0.0.1. Queue on the left; a stop shows the question, the output, the rejections, the cost and the evidence." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#7-review-page" tooltip="Shortcuts A, C, R, X. Answers need the server's token and a local Host and Origin. The page reloads when the log grows. Runs with no process show as idle, with Continue." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#fff3e0;strokeColor=#d9822b;fontColor=#1d2433;"><mxGeometry x="1370" y="230" width="290" height="130" as="geometry" /></mxCell></UserObject><UserObject id="cli" label="CLI&#10;jaynes queue lists what waits; jaynes answer RUN STEP accept|change|return|context" link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#7-review-page" tooltip="Same effect as the page: records the answer and continues the run in the background." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;"><mxGeometry x="1370" y="380" width="290" height="80" as="geometry" /></mxCell></UserObject><mxCell id="answers" value="The 4 answers&#10;accept: it is right (correct)&#10;change: you edit it; it is checked again (error)&#10;return: redo with your note (error)&#10;context: redo, but the agent was not at fault (not counted)&#10;return and context can go back to an earlier step" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;" vertex="1" parent="1"><mxGeometry x="1370" y="480" width="290" height="130" as="geometry" /></mxCell><mxCell id="s4" value="4. Everything is logged" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#c3c9d4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2b3445;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="620" height="230" as="geometry" /></mxCell><UserObject id="log" label="Event log (SQLite)&#10;Append-only. All state is rebuilt from it, which is why a kill -9 resumes exactly where it stopped." link="https://www.sqlite.org/wal.html" tooltip="jaynes.store. Events: RunStarted, StepStarted, TurnFinished, TurnRejected, TurnInterrupted, Checked, StopOpened, StopSkipped, StopAnswered, RunPaused, RunBlocked, RunFinished, and the action gate's." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f1fd;strokeColor=#3b7dd8;fontColor=#1d2433;"><mxGeometry x="60" y="730" width="280" height="160" as="geometry" /></mxCell></UserObject><UserObject id="objects" label="Checked outputs&#10;JSON files stored by the hash of their content; later steps get read-only copies." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#5-step-execution-protocol" tooltip="objects/&lt;sha256&gt;.json. A change of yours creates a new witness with source person." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f1fd;strokeColor=#3b7dd8;fontColor=#1d2433;"><mxGeometry x="360" y="730" width="280" height="160" as="geometry" /></mxCell></UserObject><mxCell id="s5" value="5. The evidence decides how often to ask" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#c3c9d4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2b3445;" vertex="1" parent="1"><mxGeometry x="690" y="690" width="630" height="230" as="geometry" /></mxCell><UserObject id="window" label="Window of labels&#10;Your answers at this stop, counted only under the step's current version (its fingerprint)." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#63-window" tooltip="Fingerprint: role, step, method, instructions, schema, the code of the checks and the question, budget, δ and model. Change any of them and the count starts over." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f1fd;strokeColor=#3b7dd8;fontColor=#1d2433;"><mxGeometry x="710" y="730" width="180" height="160" as="geometry" /></mxCell></UserObject><UserObject id="evalue" label="Evidence (e-value)&#10;Starts at 1, rises with each correct answer, drops sharply with each error. Valid to look at any time." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#64-the-guarantee" tooltip="Likelihood ratio with a uniform mixture on [0, b]. By Ville's inequality, if the true error rate is at or above the budget, the chance the evidence ever reaches 1/δ is at most δ." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f1fd;strokeColor=#3b7dd8;fontColor=#1d2433;"><mxGeometry x="910" y="730" width="180" height="160" as="geometry" /></mxCell></UserObject><UserObject id="status" label="Stop status&#10;Evidence ≥ 20 (1/δ, δ = 5%): certified, it then waits in only 10% of runs. No data: it always waits." link="https://github.com/alk0x1/jaynes/blob/main/SPEC.md#61-at-a-stop" tooltip="E.g. a 10% budget and no errors: 43 correct answers to certify. The mirror of the evidence refutes a stop that errs too often." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#e8f7ef;strokeColor=#2f9e66;fontColor=#1d2433;"><mxGeometry x="1110" y="730" width="190" height="160" as="geometry" /></mxCell></UserObject><mxCell id="s6" value="6. Safety in your own sessions" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=none;strokeColor=#c3c9d4;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#2b3445;" vertex="1" parent="1"><mxGeometry x="1350" y="690" width="330" height="230" as="geometry" /></mxCell><UserObject id="gate" label="Action gate (hook)&#10;Every Claude Code tool call is classified; dangerous actions (floors) never run without you; the rest earns autonomy by the same evidence." link="https://code.claude.com/docs/en/hooks" tooltip="jaynes hook, with the policy in jaynes.toml. Random audits produce the labels, read from the transcript." nmRole="main" nmVisual="box"><mxCell vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;spacing=8;align=left;verticalAlign=top;fillColor=#f5f6f8;strokeColor=#8a94a6;fontColor=#1d2433;"><mxGeometry x="1370" y="730" width="290" height="160" as="geometry" /></mxCell></UserObject><mxCell id="legend" value="Colours: blue = evidence and log · green = passed · amber = waits for you · red = rejected or blocked · grey = who produces" style="text;html=1;whiteSpace=wrap;fontSize=12;fontColor=#4a5468;" vertex="1" parent="1"><mxGeometry x="40" y="962" width="1300" height="24" as="geometry" /></mxCell><UserObject id="f-role" label="" nmRole="flow"><mxCell edge="1" parent="1" source="role" target="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#5b6578;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="50" y="225" /><mxPoint x="50" y="500" /></Array></mxGeometry></mxCell></UserObject><UserObject id="f-task" label="what to do" nmRole="flow"><mxCell edge="1" parent="1" source="task" target="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#5b6578;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><UserObject id="f-start" label="1st step" nmRole="flow"><mxCell edge="1" parent="1" source="start" target="ws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#5b6578;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.25;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385" y="500" /><mxPoint x="385" y="170" /></Array></mxGeometry></mxCell></UserObject><UserObject id="f-ws-turn" label="" nmRole="flow"><mxCell edge="1" parent="1" source="ws" target="turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#5b6578;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><UserObject id="f-claude" label="runs the turn" nmRole="flow"><mxCell edge="1" parent="1" source="claude" target="turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#5b6578;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.24;entryY=1;"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><UserObject id="f-codex" label="" nmRole="flow"><mxCell edge="1" parent="1" source="codex" target="turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#5b6578;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.76;entryY=1;"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><UserObject id="f-turn-b" label="" nmRole="flow"><mxCell edge="1" parent="1" source="turn" target="boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#5b6578;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><UserObject id="f-b-check" label="" nmRole="flow"><mxCell edge="1" parent="1" source="boundary" target="check" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#5b6578;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><UserObject id="f-b-rej" label="" nmRole="flow"><mxCell edge="1" parent="1" source="boundary" target="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#d64545;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><UserObject id="f-check-rej" label="failed" nmRole="flow"><mxCell edge="1" parent="1" source="check" target="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#d64545;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0.8;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1130" y="280" /><mxPoint x="1040" y="280" /></Array></mxGeometry></mxCell></UserObject><UserObject id="f-check-w" label="passed" nmRole="flow"><mxCell edge="1" parent="1" source="check" target="witness" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#2f9e66;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry" /></mxCell></UserObject><UserObject id="f-rej-turn" label="again, with the reason" nmRole="flow"><mxCell edge="1" parent="1" source="rejected" target="turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;flowAnimation=1;strokeColor=#d64545;fontSize=11;fontColor=#3d4658;labelBackgroundColor=#ffffff;exitX=0.2;exitY=0;entryX=0.9;entryY=1;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="280" /><mxPoint x="830" y="280" /></Array></mxGeometry></mxCell></UserObject><UserObject id="f-rej-blk"